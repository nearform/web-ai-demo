{
  "name": "web-ai-demo",
  "version": "0.0.1",
  "description": "Various AI models that run in the browser",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npx serve -p 4710",
    "dev:isolated": "npx serve -p 4711 --config serve.isolated.json",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --quiet",
    "pretty:fix": "prettier . --write",
    "pretty:check": "prettier . --check",
    "check": "npm run lint:check && npm run pretty:check",
    "format": "npm run lint:fix && npm run pretty:fix",
    "dep:check": "npx npm-check-updates"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6"
  }
}
